# ====================================================================
# Apache Configuration for GoDaddy / WordPress / PHP Environment
# ====================================================================

# 1. Prevent Directory Listing
Options -Indexes

# 2. Rewrite Engine Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization Header to PHP on FastCGI / PHP-FPM (GoDaddy shared hosting)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Check if browser supports WebP and file exists
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=accept:1]
</IfModule>

# 3. Cache Vary Header for WebP
<IfModule mod_headers.c>
  Header append Vary Accept env=REDIRECT_accept

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Critical Security: Block Direct Access to Sensitive Files
<FilesMatch "^(\.env.*|.*\.log|signups\.json|.*\.tmp.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# 5. Default Charset
AddDefaultCharset UTF-8
